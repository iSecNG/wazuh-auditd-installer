  </rule>

  <!-- Was 2 in 300s, which any admin running two sudo commands matched. -->
  <rule id="223353" level="10" frequency="10" timeframe="300">
    <if_matched_group>privilege_escalation</if_matched_group>
    <description>LAUREL: repeated privilege escalation activity in 5 minutes.</description>
    <group>laurel,privilege_escalation,</group>
    <mitre>
      <id>T1548</id>
    </mitre>
  </rule>


