# Minimal systemd container for exercising install.sh on a deb-based distro.
#
# BASE is any debian:* or ubuntu:* tag.
#
# Deliberately does NOT install curl, gnupg or ca-certificates: install_falco()
# and the Wazuh repo setup are supposed to pull those in themselves, and a
# minimal image is the only way to prove they do.
ARG BASE=debian:12
FROM ${BASE}

ENV DEBIAN_FRONTEND=noninteractive

# systemd as PID 1 so the installer's `systemctl enable/is-active` calls behave
# the way they do on a real host.
RUN apt-get update && apt-get install -y --no-install-recommends \
      systemd systemd-sysv procps sudo \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
